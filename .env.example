# API Environment, local|test|prod
NODE_ENV=development

# Server Configuration
API_HOST='localhost'
API_PORT=3000

# CORS Configuration
ALLOWED_ORIGINS='http://localhost:8080'

# Microsoft Entra ID Configuration (Backend/API)
# Get these from your Agent0 API app registration in Entra admin center
ENTRA_TENANT_ID='your-tenant-id'                              # Directory (tenant) ID
ENTRA_CLIENT_ID='your-api-client-id'                          # Application (client) ID of Agent0 API
ENTRA_CLIENT_SECRET='your-api-client-secret'                  # Client secret from Certificates & secrets
ENTRA_AUDIENCE='api://your-api-client-id'                     # Application ID URI from Expose an API

# Frontend Entra Configuration (prefix with VITE_ for Vite)
# Get these from your Agent0 SPA app registration in Entra admin center
VITE_ENTRA_TENANT_ID='your-tenant-id'                         # Directory (tenant) ID (same as above)
VITE_ENTRA_CLIENT_ID='your-spa-client-id'                     # Application (client) ID of Agent0 SPA
VITE_ENTRA_API_SCOPE='api://your-api-client-id/access_as_user' # API scope to request

# Agent0 Configuration
OPENAI_API_KEY='your-openai-api-key'                          # OpenAI API key from platform.openai.com
